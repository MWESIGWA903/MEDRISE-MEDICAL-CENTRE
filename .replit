modules = ["nodejs-20", "web", "bash"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd MEDRISE-MEDICAL-CENTRE-main && PORT=8080 pnpm --filter @workspace/api-server dev & PORT=5000 pnpm --filter @workspace/medrise dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "cd MEDRISE-MEDICAL-CENTRE-main && PORT=8080 node --enable-source-maps artifacts/api-server/dist/index.mjs & PORT=5000 pnpm --filter @workspace/medrise serve"]
build = ["bash", "-c", "cd MEDRISE-MEDICAL-CENTRE-main && pnpm install && pnpm --filter @workspace/api-server build && PORT=5000 pnpm --filter @workspace/medrise build"]
